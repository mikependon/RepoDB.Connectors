<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>RepoDb.Connector.MariaDbConnector</Title>
    <AssemblyName>RepoDb.Connector.MariaDbConnector</AssemblyName>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>A connector for MariaDB used by RepoDB. This uses the MySqlConnector library underneath.</Description>
    <Authors>mike_pendon</Authors>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageTags>mariadb ado.net data provider database</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/mikependon/RepoDB.Connectors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mikependon/RepoDB.Connectors</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.290" />
  </ItemGroup>

</Project>
