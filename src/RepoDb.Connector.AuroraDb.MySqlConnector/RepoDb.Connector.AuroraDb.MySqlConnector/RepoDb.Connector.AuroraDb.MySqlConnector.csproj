<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>RepoDb.Connector.AuroraDb.MySqlConnector</Title>
    <AssemblyName>RepoDb.Connector.AuroraDb.MySqlConnector</AssemblyName>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>A connector for Amazon Aurora MySQL used by RepoDB. This uses the AWS Advanced .NET Data Provider Wrapper on top of the MySqlConnector library.</Description>
    <Authors>mike_pendon</Authors>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageTags>auroradb aurora aws amazon mysql mysqlconnector ado.net data provider database</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/mikependon/RepoDB.Connectors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mikependon/RepoDB.Connectors</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWS.AdvancedDotnetDataProviderWrapper.Core" Version="2.2.0" />
    <PackageReference Include="AWS.AdvancedDotnetDataProviderWrapper.Dialect.MySqlConnector" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RepoDb.Connector.AuroraDb.MySqlConnector.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.290" />
  </ItemGroup>

</Project>
